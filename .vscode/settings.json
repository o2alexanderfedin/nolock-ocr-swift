{
    "swift.path.sourcekitLsp": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/sourcekit-lsp",
    "swift.autoGenerateLaunchConfigurations": true,
    "editor.formatOnSave": true,
    "[swift]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "files.exclude": {
        "**/.build": true,
        "**/.swiftpm": true
    },
    "search.exclude": {
        "**/.build": true,
        "**/.swiftpm": true
    },
    "files.associations": {
        "*.swift": "swift"
    },
    "lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
    "lldb.launch.sourceLanguages": ["swift"],
    "lldb.adapterType": "native"
}